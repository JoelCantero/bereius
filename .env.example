# Local dev: copy to `.env` and fill real values (NEVER commit `.env`).
# Production: set these as GitHub Secrets (sensitive) and Variables (non-sensitive).
# The deploy workflow injects them into the containers; no .env file on the host.

# --- Development seed user ---
SEED_USER_NAME=your-name
SEED_USER_EMAIL=you@example.com

# --- App ---
# Project name: Docker image names, Traefik router, and the deploy dir derive from it.
PROJECT_NAME=fullstack-webapp-template
# Public site-wide identity used by the web UI and transactional email.
BRAND_COLOR="#0E79B2"
SUPPORT_EMAIL=login@versmedit.com

# --- Database (PostgreSQL) ---
# POSTGRES_USER and POSTGRES_DB are derived from PROJECT_NAME (dev: compose, prod: workflow).
# Only the password is set here / as a secret. Percent-encode reserved characters
# when placing the local password in DATABASE_URL (the deploy workflow does this automatically).
POSTGRES_PASSWORD=change-me
# Host port the dev container publishes on (change it when 5432 is taken locally).
POSTGRES_HOST_PORT=5432
# Prisma connection string for local dev (the Dockerized DB is published on localhost).
# User and DB name must match PROJECT_NAME (compose derives POSTGRES_USER/POSTGRES_DB from it).
DATABASE_URL=postgresql://fullstack-webapp-template:change-me@localhost:5432/fullstack-webapp-template?schema=public

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical external origin. Production derives this from APP_DOMAIN.
NEXTAUTH_URL=http://localhost:3000
# Accept forwarding headers only when direct access to the app is blocked.
# Enable only when Cloudflare is the exclusive origin path and the ingress
# overwrites forwarded host and cf-connecting-ip headers on every request.
TRUST_PROXY_HEADERS=false

# --- Personal data export bounds (optional) ---
# Maximum fully buffered UTF-8 JSON attachment size (25 MiB).
ACCOUNT_DATA_EXPORT_MAX_BYTES=26214400
# Maximum active export generation time in milliseconds.
ACCOUNT_DATA_EXPORT_TIMEOUT_MS=30000

# --- Transactional email HTTP provider ---
# Global gate for login, signup onboarding, and existing-account notices.
# Provider credentials alone never enable email.
MAIL_ENABLED=false
# Required when enabled: exact lowercase `brevo` or `mailjet`.
MAIL_PROVIDER=
# Secret API key for the selected provider.
MAIL_API_KEY=
# Secret required only for Mailjet; leave empty for Brevo.
MAIL_API_SECRET=
# Bare verified sender address. PROJECT_NAME supplies the display name.
MAIL_FROM=
# Optional shared absolute HTTPS logo URL. Empty disables the logo.
MAIL_LOGO_URL=

# --- Booking pipeline ---
# Global gate for intake, quoting and booking notifications.
# Provider credentials alone never enable the pipeline.
BOOKING_ENABLED=false
# Required when enabled: Holded invoicing API key.
HOLDED_API_KEY=
# Required when enabled: Gravity Forms REST API v2 base URL (HTTPS only).
GRAVITY_FORMS_API_URL=
# Required when enabled: Gravity Forms API consumer key and secret.
GRAVITY_FORMS_CONSUMER_KEY=
GRAVITY_FORMS_CONSUMER_SECRET=
# Required when enabled: numeric identifier of the booking request form.
GRAVITY_FORMS_FORM_ID=
# Required when enabled: AES-256-GCM key encrypting the stored booking SMTP
# password. Generate with: openssl rand -base64 32
BOOKING_MAIL_KEY=

# --- Logging (optional) ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
