{
  "name": "fullstack-webapp-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "scripts": {
    "predev": "docker compose up -d --wait db && pnpm db:deploy && NODE_ENV=development node prisma/seed.mjs",
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash scripts/test-e2e.sh",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:backup:dev": "COMPOSE_FILE=docker-compose.yml bash scripts/db-backup.sh",
    "db:restore:dev": "COMPOSE_FILE=docker-compose.yml bash scripts/db-restore.sh",
    "email:dev": "NEXT_TELEMETRY_DISABLED=1 next dev emails --hostname 127.0.0.1 --port 3001"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@swc/helpers": "0.5.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
