// Prisma schema. Docs: https://pris.ly/d/prisma-schema
// Apply changes with migrations (constitution → Database Rules):
//   pnpm db:migrate   (dev)   /   pnpm db:deploy (prod)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (datasource.url), not here.
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum VerificationPurpose {
  LOGIN
  SIGNUP
  ACCOUNT_DELETION
  ACCOUNT_SECURITY
  ACCOUNT_DATA_EXPORT
}

// Auth.js (NextAuth) models — canonical Prisma adapter schema plus app timestamps.
// Add app-specific fields/relations here, then run `pnpm db:migrate`.
model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  normalizedEmail  String            @unique
  emailVerified    DateTime?
  image            String?
  status           UserStatus        @default(ACTIVE)
  role             UserRole          @default(OPERATOR)
  accounts         Account[]
  sessions         Session[]
  policyAcceptance PolicyAcceptance?

  bookingDecisions           BookingRequest[]             @relation("BookingDecisions")
  paymentsRecorded           Payment[]                    @relation("PaymentsRecorded")
  bookingAuditEvents         BookingAuditEvent[]          @relation("BookingAuditActor")
  integrationSettings        IntegrationSettings[]        @relation("IntegrationSettingsUpdatedBy")
  treasuryAccountsConfigured HoldedTreasuryAccount[]      @relation("TreasuryAccountsConfigured")
  bankSyncRunsRequested      BankSyncRun[]                @relation("BankSyncRunsRequested")
  bankProposalsDecided       BankReconciliationProposal[] @relation("BankProposalsDecided")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id                      String                   @id @default(cuid())
  sessionToken            String                   @unique
  userId                  String
  expires                 DateTime
  createdAt               DateTime?
  authenticatedAt         DateTime?
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataExportAuthorization DataExportAuthorization?

  @@index([userId, expires])
}

model DataExportAuthorization {
  sessionId   String   @id
  confirmedAt DateTime
  expiresAt   DateTime
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model VerificationToken {
  identifier        String
  token             String              @unique
  expires           DateTime
  purpose           VerificationPurpose @default(LOGIN)
  loginCodeHash     String?
  loginCodeAttempts Int                 @default(0)
  proposedName      String?
  locale            String?
  termsVersion      String?
  privacyVersion    String?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime            @default(now())

  @@unique([identifier, token])
  @@index([identifier, purpose, expires])
}

model PolicyAcceptance {
  id             String   @id @default(cuid())
  userId         String   @unique
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// --- Booking pipeline ---

enum UserRole {
  OPERATOR
  ADMINISTRATOR
}

enum BoardType {
  SELF_CATERING
  FULL_BOARD
}

enum BookingState {
  IN_REVIEW
  AWAITING_PAYMENT
  CONFIRMED
  INVOICED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum HoldedDocumentType {
  ESTIMATE
  RESERVE_INVOICE
  FINAL_INVOICE
}

enum IntegrationJobStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  DEAD
}

enum IntegrationProvider {
  HOLDED
  GRAVITY_FORMS
  BOOKING_MAIL
}

enum DocumentDeliveryStatus {
  PREPARED
  IN_FLIGHT
  ACCEPTED
  FAILED
  UNKNOWN
}

enum DocumentIssuanceStatus {
  PREPARED
  IN_FLIGHT
  ISSUED
  FAILED
  BLOCKED
  UNKNOWN
}

enum BankMovementDirection {
  INCOME
  EXPENSE
}

enum BankSyncTrigger {
  SCHEDULED
  MANUAL
  EXPIRY
}

enum BankSyncStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum BankSyncIncidentCode {
  PROVIDER_UNAUTHORIZED
  PROVIDER_NOT_FOUND
  PROVIDER_RATE_LIMITED
  PROVIDER_UNAVAILABLE
  PROVIDER_REQUEST_REJECTED
  RESPONSE_TOO_LARGE
  MALFORMED_PAGE
  MISSING_CURSOR
  REPEATED_CURSOR
  INVALID_MOVEMENT_ID
  ACCOUNT_MISMATCH
  INVALID_BOOKING_DATE
  INVALID_VALUE_DATE
  INVALID_AMOUNT
  ZERO_AMOUNT
  INVALID_CURRENCY
  DESCRIPTION_TOO_LONG
  CONFIRMED_MATCH_CHANGED
}

enum BankReconciliationStatus {
  PENDING
  CONFIRMED
  DISMISSED
  INVALIDATED
}

model Customer {
  id                  String           @id @default(cuid())
  taxId               String           @unique
  name                String
  email               String
  phone               String?
  addressLine         String?
  city                String?
  province            String?
  postalCode          String?
  country             String?
  // Holded contact mirrored by the quoting sequence; absent until first created.
  holdedContactId     String?
  // Replaces the tax identifiers the retired workflow hardcoded in an expression.
  negotiatedServiceId String?
  bookingRequests     BookingRequest[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model BookingRequest {
  id             String       @id @default(cuid())
  gravityEntryId String       @unique
  customerId     String
  state          BookingState @default(IN_REVIEW)
  boardType      BoardType
  // Calendar dates, never timestamps: night counts must not depend on a time zone.
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  headcount      Int
  // Person-nights actually billed, after the 30-place floor.
  billableUnits  Int?
  // Amounts in integer cents; floating point never touches money.
  unitPriceCents Int?
  advanceCents   Int?
  depositCents   Int?
  paymentDueAt   DateTime?
  submittedAt    DateTime
  decidedAt      DateTime?
  decidedById    String?
  decisionReason String?

  customer                    Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  decidedBy                   User?                        @relation("BookingDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  documents                   HoldedDocument[]
  documentIssuances           DocumentIssuance[]
  payments                    Payment[]
  auditEvents                 BookingAuditEvent[]
  bankReconciliationProposals BankReconciliationProposal[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@index([state, createdAt])
  @@index([customerId])
}

model HoldedDocument {
  id               String             @id @default(cuid())
  bookingRequestId String
  type             HoldedDocumentType
  holdedId         String
  documentNumber   String?
  totalCents       Int?
  // Set once the document has been mailed, so a retry never sends it twice.
  sentAt           DateTime?
  issuedAt         DateTime           @default(now())

  bookingRequest BookingRequest    @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  delivery       DocumentDelivery?
  issuance       DocumentIssuance?

  // One document of each kind per booking: the quoting retry cannot duplicate.
  @@unique([bookingRequestId, type])
}

model DocumentDelivery {
  id               String                 @id @default(cuid())
  holdedDocumentId String                 @unique
  status           DocumentDeliveryStatus @default(PREPARED)
  toEmail          String
  ccEmails         Json
  attemptedAt      DateTime?
  acceptedAt       DateTime?
  outcomeUnknownAt DateTime?
  lastFailureCode  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  holdedDocument HoldedDocument @relation(fields: [holdedDocumentId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model DocumentIssuance {
  id               String                 @id @default(cuid())
  bookingRequestId String
  type             HoldedDocumentType
  holdedDocumentId String?                @unique
  status           DocumentIssuanceStatus @default(PREPARED)
  attemptedAt      DateTime?
  issuedAt         DateTime?
  blockedAt        DateTime?
  outcomeUnknownAt DateTime?
  lastFailureCode  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  bookingRequest BookingRequest  @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  holdedDocument HoldedDocument? @relation(fields: [holdedDocumentId], references: [id], onDelete: SetNull)

  @@unique([bookingRequestId, type])
  @@index([status, updatedAt])
}

model Payment {
  id               String   @id @default(cuid())
  bookingRequestId String
  amountCents      Int
  receivedAt       DateTime
  reference        String?
  recordedById     String?
  bankMovementId   String?  @unique
  createdAt        DateTime @default(now())

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  recordedBy     User?          @relation("PaymentsRecorded", fields: [recordedById], references: [id], onDelete: SetNull)
  bankMovement   BankMovement?  @relation(fields: [bankMovementId], references: [id], onDelete: Restrict)

  @@index([bookingRequestId])
}

model BookingAuditEvent {
  id               String        @id @default(cuid())
  bookingRequestId String
  // Null when the transition was made by a scheduled job, or when the operator
  // who made it later deleted their account.
  actorUserId      String?
  fromState        BookingState?
  toState          BookingState
  reason           String?
  createdAt        DateTime      @default(now())

  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  actor          User?          @relation("BookingAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingRequestId, createdAt])
}

model IntegrationJob {
  id             String               @id @default(cuid())
  kind           String
  idempotencyKey String               @unique
  payload        Json
  status         IntegrationJobStatus @default(PENDING)
  attempts       Int                  @default(0)
  runAfter       DateTime             @default(now())
  claimedAt      DateTime?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, runAfter])
}

model IntegrationSettings {
  provider         IntegrationProvider @id
  // Non-secret configuration: Gravity Forms base URL and form id, SMTP host,
  // port and sender address.
  config           Json
  // AES-256-GCM envelope of the credential, encrypted with BOOKING_SECRET_KEY.
  // Null means the integration is not configured, and therefore inactive.
  secretCiphertext Bytes?
  secretIv         Bytes?
  secretAuthTag    Bytes?
  // Last successful test-connection, so a stale credential is visible.
  verifiedAt       DateTime?
  updatedById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  updatedBy User? @relation("IntegrationSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model HoldedTreasuryAccount {
  id                 String    @id @default(cuid())
  holdedAccountId    String    @unique
  displayName        String
  currency           String
  importStartDate    DateTime  @db.Date
  retentionFloorDate DateTime? @db.Date
  active             Boolean   @default(false)
  configuredById     String?
  nextScheduledAt    DateTime
  lastAttemptAt      DateTime?
  lastSuccessfulAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  configuredBy User?          @relation("TreasuryAccountsConfigured", fields: [configuredById], references: [id], onDelete: SetNull)
  movements    BankMovement[]
  syncRuns     BankSyncRun[]

  @@index([active, nextScheduledAt])
}

model BankMovement {
  id               String                @id @default(cuid())
  accountId        String
  holdedMovementId String
  bookingDate      DateTime              @db.Date
  valueDate        DateTime?             @db.Date
  narrative        String?               @db.Text
  amountMinor      BigInt
  currency         String
  providerStatus   String?
  direction        BankMovementDirection
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  account   HoldedTreasuryAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  proposals BankReconciliationProposal[]
  payment   Payment?

  @@unique([accountId, holdedMovementId])
  @@index([bookingDate(sort: Desc), holdedMovementId])
  @@index([accountId, bookingDate(sort: Desc)])
  @@index([direction, bookingDate(sort: Desc)])
  @@index([currency, bookingDate(sort: Desc)])
}

model BankSyncRun {
  id                      String                @id @default(cuid())
  accountId               String
  trigger                 BankSyncTrigger
  status                  BankSyncStatus        @default(QUEUED)
  requestedById           String?
  resumedFromRunId        String?
  windowStartDate         DateTime              @db.Date
  nextCursor              String?               @db.Text
  lastProcessedMovementId String?
  pageCount               Int                   @default(0)
  itemCount               Int                   @default(0)
  insertedCount           Int                   @default(0)
  updatedCount            Int                   @default(0)
  unchangedCount          Int                   @default(0)
  incidentCount           Int                   @default(0)
  attemptCount            Int                   @default(0)
  nextAttemptAt           DateTime              @default(now())
  leaseToken              String?
  leaseExpiresAt          DateTime?
  heartbeatAt             DateTime?
  failureCode             BankSyncIncidentCode?
  startedAt               DateTime?
  exhaustedAt             DateTime?
  finishedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  account     HoldedTreasuryAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  requestedBy User?                 @relation("BankSyncRunsRequested", fields: [requestedById], references: [id], onDelete: SetNull)
  resumedFrom BankSyncRun?          @relation("BankSyncRunResumption", fields: [resumedFromRunId], references: [id], onDelete: SetNull)
  resumedRuns BankSyncRun[]         @relation("BankSyncRunResumption")
  incidents   BankSyncIncident[]

  @@index([status, nextAttemptAt])
  @@index([accountId, createdAt(sort: Desc)])
}

model BankSyncIncident {
  id               String               @id @default(cuid())
  runId            String
  code             BankSyncIncidentCode
  pageNumber       Int
  itemIndex        Int?
  holdedMovementId String?
  createdAt        DateTime             @default(now())

  run BankSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model BankReconciliationProposal {
  id               String                   @id @default(cuid())
  movementId       String
  bookingRequestId String
  status           BankReconciliationStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  invalidatedAt    DateTime?
  invalidationCode String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  movement       BankMovement   @relation(fields: [movementId], references: [id], onDelete: Restrict)
  bookingRequest BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Restrict)
  decidedBy      User?          @relation("BankProposalsDecided", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([movementId, bookingRequestId])
  @@index([status, createdAt(sort: Desc)])
  @@index([bookingRequestId, status])
}

model IntakeCursor {
  source      String   @id
  lastEntryId String
  updatedAt   DateTime @updatedAt
}
